XAI_API_KEY=
XAI_MODEL=grok-4.3

# Supabase (Project Settings → API). These two are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
# Used to add and refund units; marking is unavailable without it.
SUPABASE_SECRET_KEY=

# Public address of the site, used in sign-up and password-reset emails.
# Leave empty in development to use the request's own address.
NEXT_PUBLIC_SITE_URL=

# Paystack (Dashboard → Settings → API Keys & Webhooks). SERVER ONLY.
# Use sk_test_... while testing and sk_live_... in production. The same key
# verifies webhook signatures.
PAYSTACK_SECRET_KEY=

# Only for running migrations from your machine. URL-encode special characters
# in the password (e.g. "@" becomes %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Transactional email (welcome emails and partner payout notifications).
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=EssayMarker
PAYOUT_NOTIFY_EMAIL=notifications@example.com
